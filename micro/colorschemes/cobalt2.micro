# Cobalt2 palette of tabby/config.yaml and tmux/tmux.conf, used by micro through tmux/notes.sh.
# Linked to ~/.config/micro/colorschemes/ by `just tmux`.
color-link default "#ffffff,#132738"
color-link cursor-line "#1f4662"
color-link color-column "#1f4662"
color-link selection "#ffffff,#0050a4"
color-link line-number "#2e5b7d,#132738"
color-link current-line-number "#ffc600,#132738"
color-link statusline "#ffffff,#193549"
color-link statusline.inactive "#aaaaaa,#193549"
color-link statusline.suggestions "#ffc600,#193549"
color-link tabbar "#ffffff,#193549"
color-link tabbar.active "bold #193549,#ffc600"
color-link message "#ffffff,#132738"
color-link error-message "bold #ff628c,#132738"
color-link divider "#2e5b7d,#132738"
color-link scrollbar "#2e5b7d"
color-link indent-char "#2e5b7d"
color-link comment "italic #0088ff"
color-link todo "bold #193549,#ffc600"
color-link constant "#ff628c"
color-link constant.string "#3ad900"
color-link constant.number "#ff628c"
color-link identifier "#ffc600"
color-link statement "#ff9d00"
color-link symbol "#ff9d00"
color-link preproc "#ff9d00"
color-link type "#ffc600"
color-link special "bold #ffc600"
color-link underlined "underline #6ae3fa"
color-link error "bold #ff0000"
color-link match-brace "#193549,#ffc600"
color-link hlsearch "#193549,#ffc600"
color-link trailingws ",#ff628c"
color-link tab-error ",#ff628c"
color-link diff-added "#3ad900"
color-link diff-modified "#ffc600"
color-link diff-deleted "#ff0000"
color-link gutter-error "#ff0000"
color-link gutter-warning "#ffc600"
color-link gutter-info "#0088ff"
